# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend & Checkout URLs
FRONTEND_URL=http://localhost:5173
CHECKOUT_URL=http://localhost:5173
CHECKOUT_FRONTEND_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://localhost:27017/fastpay

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_access_key_32chars
JWT_REFRESH_SECRET=your_jwt_super_secret_refresh_key_32chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# SMTP / Nodemailer Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=FastPay

# Rate Limiting & Security
CORS_ORIGIN=*
UPLOAD_PATH=uploads/
LOG_LEVEL=info
API_PREFIX=/api/v1
TZ=Asia/Dhaka

# ImgBB Image Upload Service
IMGBB_API_KEY=

